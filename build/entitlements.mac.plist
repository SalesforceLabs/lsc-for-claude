<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron/Chromium need JIT and writable+executable memory. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- No disable-library-validation or allow-dyld-environment-variables: native modules
       (better-sqlite3) are signed with the app's identity, and DYLD_* injection stays blocked. -->
</dict>
</plist>
