{
  "name": "LSC-for-Claude",
  "version": "0.3.1",
  "description": "MCP server for LSC Customer Engagement",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "build": "tsc",
    "bundle": "esbuild src/index.ts --bundle --platform=node --target=node18 --format=esm --outfile=mcp-server/index.mjs --external:better-sqlite3 --external:rollup --external:@lwc/* --external:lightning-base-components --banner:js=\"import{createRequire as __bundleRequire}from'module';const require=__bundleRequire(import.meta.url);\"",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "test": "vitest",
    "verify": "bash scripts/verify.sh",
    "electron:build": "tsc -p tsconfig.electron.json && vite build --config vite.renderer.config.ts",
    "electron:dev": "concurrently -k -n server,main,vite,electron \"tsc --watch --preserveWatchOutput\" \"tsc -p tsconfig.electron.json --watch --preserveWatchOutput\" \"vite --config vite.renderer.config.ts --strictPort\" \"wait-on tcp:5173 dist/index.js dist-electron/main.js && LSC_RENDERER_URL=http://localhost:5173 node scripts/dev-electron.mjs\"",
    "electron:start": "electron dist-electron/main.js",
    "electron:pack": "npm run build && npm run electron:build && electron-builder --publish never",
    "process-guides": "tsx scripts/process-pdf-sections.ts"
  },
  "keywords": [
    "mcp",
    "salesforce",
    "life-sciences-cloud",
    "claude"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@lwc/engine-dom": "^9.5.1",
    "@lwc/rollup-plugin": "^9.5.1",
    "@lwc/synthetic-shadow": "^9.5.1",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@salesforce-ux/design-system": "^2.264.1",
    "@types/archiver": "^7.0.0",
    "@xyflow/react": "^12.12.0",
    "acorn": "^8.19.0",
    "archiver": "^7.0.1",
    "better-sqlite3": "^12.11.1",
    "dompurify": "^3.4.17",
    "fast-xml-parser": "^5.11.2",
    "lightning-base-components": "^1.28.19-alpha",
    "lucide-react": "^1.57.0",
    "mermaid": "^11.12.3",
    "pdf-lib": "^1.17.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "rollup": "^4.64.6",
    "yaml": "^2.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^1.6.1",
    "concurrently": "^8.2.0",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.21.5",
    "eslint": "^8.57.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vitest": "^1.4.0",
    "wait-on": "^9.0.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
